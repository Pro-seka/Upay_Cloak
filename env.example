# ==========================================
# UpayShield Configuration (.env)
# ==========================================

# --- Artifact Paths (relative to repository root or absolute)
UPAY_DATA_PATH=data/transactions.csv
UPAY_MODEL_PATH=models/risk_engine.joblib
UPAY_REPORTS_DIR=reports
UPAY_CACHE_DIR=data/cache
UPAY_DB_PATH=data/upayshield.db
UPAY_AUTO_TRAIN=false

# --- Server & HTTP
UPAY_CORS_ORIGINS=["*"]
UPAY_STREAM_DEFAULT_INTERVAL_MS=3500
UPAY_STREAM_DEMO_ALERT_EVERY=6

# --- AI Investigation Assistant (Optional: defaults to grounded template fallback if unset)
# Provider options: "none", "gemini", "anthropic", "openai"
UPAY_LLM_PROVIDER=none
UPAY_LLM_API_KEY=your_llm_api_key_here
UPAY_LLM_MODEL=gemini-2.0-flash
UPAY_LLM_TIMEOUT_S=8.0
UPAY_LLM_MAX_RETRIES=1
